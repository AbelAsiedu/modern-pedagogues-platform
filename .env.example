# Copy to .env and fill in. Never commit .env. All variables are validated at startup
# by src/server/env.ts; the app refuses to start in production with missing values.

NODE_ENV=development

# Public base URL, used in emails and payment callbacks. Must be https in production.
APP_URL=http://localhost:3000

# PostgreSQL connection string (managed Postgres in production).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tmp_dev

# Used only by the integration test runner. Must point at a throwaway database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tmp_test

# Database TLS. Required by managed Postgres. On Heroku also set
# DATABASE_SSL_REJECT_UNAUTHORIZED=false (its certificate chain cannot be verified by Node).
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Email. EMAIL_PROVIDER=console in development (messages are logged, not sent).
# Production uses smtp, for example Gmail with a Google App Password:
EMAIL_PROVIDER=console
EMAIL_FROM="The Modern Pedagogues <abelasiedu@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=abelasiedu@gmail.com
# SMTP_PASSWORD=<16-character Google App Password>

# Paystack online payment for the shop. The SECRET key only (sk_test_... or sk_live_...); the public key is not used.
# Unset = the shop uses manual Mobile Money confirmation. Set it on Heroku as a Config Var; never commit it.
# PAYSTACK_SECRET_KEY=

# S3-compatible object storage (Phase 17 / storage module).
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET_PRIVATE=
# STORAGE_BUCKET_PUBLIC=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Kaitlyn AI assistant (optional; switched off when no key is set). Keys stay on the server and are never sent to browsers.
# Providers are tried in this order: Gemini, OpenRouter, Mistral. Set at least one.
# GEMINI_API_KEY=            # or GOOGLE_API_KEY
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# ASSISTANT_DAILY_LIMIT=1000   # maximum Kaitlyn replies per day, all visitors combined

# Two-step sign-in (authenticator app). Without a key nobody can set it up and staff are not required to use it.
# Make a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: if it is lost, authenticator apps stop working (recovery codes still do).
# MFA_ENCRYPTION_KEY=
# STAFF_MFA_REQUIRED=true      # set false only in an emergency; staff roles are withheld until staff finish set-up
