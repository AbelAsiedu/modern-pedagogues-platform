# Copy to .env and fill in. Never commit .env. All variables are validated at startup
# by src/server/env.ts; the app refuses to start in production with missing values.

NODE_ENV=development

# Public base URL, used in emails and payment callbacks. Must be https in production.
APP_URL=http://localhost:3000

# PostgreSQL connection string (managed Postgres in production).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tmp_dev

# Used only by the integration test runner. Must point at a throwaway database.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tmp_test

# Database TLS. Required by managed Postgres. On Heroku also set
# DATABASE_SSL_REJECT_UNAUTHORIZED=false (its certificate chain cannot be verified by Node).
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Email. EMAIL_PROVIDER=console in development (messages are logged, not sent).
# Production uses smtp, for example Gmail with a Google App Password:
EMAIL_PROVIDER=console
EMAIL_FROM="The Modern Pedagogues <themodernpedagogues@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=themodernpedagogues@gmail.com
# SMTP_PASSWORD=<16-character Google App Password>

# Paystack (Phase 9). Use test keys outside production. Payments fail closed when unset.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# S3-compatible object storage (Phase 17 / storage module).
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_BUCKET_PRIVATE=
# STORAGE_BUCKET_PUBLIC=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# Kaitlyn AI assistant (optional module, disabled when unset).
# LLM_PROVIDER=
# LLM_API_KEY=
